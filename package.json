{
	"name": "buscaloenchatgpt",
	"version": "0.1.0",
	"description": "Parodia tipo LMGTFY: enlace compartible, animación y redirección a ChatGPT (sin trackers en el meme).",
	"keywords": [
		"ChatGPT",
		"LMGTFY",
		"meme",
		"SvelteKit"
	],
	"homepage": "https://buscaloenchatgpt.com",
	"bugs": {
		"url": "https://github.com/FrancBG/buscaloenchatgpt/issues"
	},
	"license": "AGPL-3.0-or-later",
	"repository": "github:FrancBG/buscaloenchatgpt",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"clean": "rm -rf .svelte-kit build dist docs node_modules tsconfig.tsbuildinfo",
		"preview": "vite preview",
		"test": "pnpm run test:integration && pnpm run test:unit",
		"test:integration": "playwright test",
		"test:unit": "vitest --sequence.concurrent",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "eslint --fix . && pnpm run format --list-different",
		"format": "prettier --write .",
		"docker:build": "docker build --secret id=BUILD_BASE --tag buscaloenchatgpt .",
		"docker:run": "docker run --publish 127.0.0.1:3000:3000 buscaloenchatgpt",
		"docker:kill": "docker ps --format '{{.Image}} {{.ID}}' | grep buscaloenchatgpt | awk '{print $2}' | xargs docker kill",
		"sync": "svelte-kit sync"
	},
	"devDependencies": {
		"@eslint/js": "^9.21.0",
		"@natoboram/heroicons.svelte": "^1.2.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^3.2.5",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.62.0",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"@testing-library/svelte": "^4.2.3",
		"@testing-library/user-event": "^14.6.1",
		"autoprefixer": "^10.5.0",
		"eslint": "^9.21.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.11.0",
		"happy-dom": "^20.9.0",
		"postcss": "^8.5.6",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^4.2.19",
		"svelte-check": "^3.8.6",
		"svelte-eslint-parser": "^0.43.0",
		"tailwindcss": "^3.4.18",
		"tslib": "^2.8.1",
		"typescript": "5.8.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^5.4.21",
		"vitest": "^2.1.9"
	},
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.4",
	"engines": {
		"node": ">=22",
		"pnpm": ">=10"
	}
}
